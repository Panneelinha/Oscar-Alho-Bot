# ===== Discord =====
# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=cole_aqui_o_token_do_bot

# (opcional) ID do servidor para sincronizar os comandos instantaneamente durante
# o desenvolvimento. Deixe em branco para registrar os comandos globalmente
# (pode levar ~1h para aparecer na primeira vez).
GUILD_ID=

# Canal onde os anúncios automáticos serão postados (clique direito no canal >
# Copiar ID do canal). Sem isso, os anúncios automáticos ficam desligados.
ANNOUNCE_CHANNEL_ID=

# ===== Trello =====
# Gere em https://trello.com/power-ups/admin (crie um Power-Up) ou em
# https://trello.com/app-key  ->  "Key" e depois clique em "Token".
TRELLO_API_KEY=cole_aqui_a_key
TRELLO_TOKEN=cole_aqui_o_token

# Board OSCAR ALHO (já preenchido). Troque se mudar de board.
TRELLO_BOARD_ID=6a2a1f1c8edcf60ea0226a9a

# Caminho do banco de votos/indicações. No PC pode deixar em branco (padrão).
# Em deploy com volume, aponte para o volume (ex.: /data/oscar_alho.sqlite3).
DB_PATH=

# ===== Comportamento =====
# De quantos em quantos minutos checar o Trello para anunciar novidades.
POLL_MINUTES=30

# ===== Sincronização diária dos votos no Trello (sigilosa: só números) =====
# Hora do dia (0-23, fuso America/Sao_Paulo) em que o bot grava o placar de
# votos nos cards do Trello.
TRELLO_SYNC_HOUR=23
# Como gravar:
#   desc    -> atualiza um bloco fixo na descrição do card (recomendado)
#   comment -> adiciona um comentário por dia
#   off     -> não escreve nada no Trello
VOTE_SYNC_MODE=desc

# ===== Lembrete de sessão =====
# Quantas horas antes da sessão o bot manda o lembrete no canal de anúncios.
LEMBRETE_HORAS=3
# (opcional) ID do cargo a marcar no lembrete (ex.: @Cinéfilos). Em branco = sem ping.
LEMBRETE_ROLE_ID=

# ===== Telegram (opcional — anúncios + consultas, só para autorizados) =====
# Token do bot do Telegram (crie com o @BotFather). Em branco = Telegram desligado.
TELEGRAM_TOKEN=
# IDs de usuários do Telegram autorizados a usar os comandos (separados por vírgula).
# Descubra o seu enviando /start ao bot, ou com o @userinfobot.
TELEGRAM_ALLOWED_IDS=
# (opcional) ID do chat onde os anúncios serão espelhados (seu chat privado, ou um grupo).
TELEGRAM_CHAT_ID=

# ===== Kick (opcional) =====
# Slug do canal na Kick (ex.: kick.com/panneelinha -> "panneelinha"). Liga o link nos anúncios.
KICK_CHANNEL_SLUG=
# App de desenvolvedor da Kick (Client ID/Secret) — habilita postar no chat.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Refresh token OAuth (gerado uma vez via autorização). Secreto. Rotaciona no banco.
KICK_REFRESH_TOKEN=
# ID do chatroom (para LER o chat e responder comandos !). Pegue uma vez; não muda.
KICK_CHATROOM_ID=
